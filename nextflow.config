params {
    input_dir = 'data/raw/extracted'
    samplesheet = 'manifests/samplesheet.csv'
    qc_thresholds = 'config/qc_thresholds.json'

    processed_dir = 'data/processed'
    qc_results_dir = 'results/qc'
    embedding_results_dir = 'results/embedding'
    annotation_results_dir = 'results/annotation'
    heterogeneity_results_dir = 'results/heterogeneity'
    cnv_results_dir = 'results/cnv'
    de_results_dir = 'results/differential_expression'
    enrichment_results_dir = 'results/enrichment'
}

process {
    executor = 'local'
    cpus = 2
    memory = '4 GB'

    withName:DETECT_DOUBLETS {
        cpus = 2
        memory = '5 GB'
    }

    withName:PREPROCESS {
        cpus = 2
        memory = '5 GB'
    }

    withName:EMBEDDING_CLUSTERING {
        cpus = 2
        memory = '5 GB'
    }

    withName:MARKER_DISCOVERY {
        cpus = 2
        memory = '5 GB'
    }

    withName:ANNOTATE_CELLS {
        cpus = 2
        memory = '5 GB'
    }

    withName:TUMOR_HETEROGENEITY {
        cpus = 2
        memory = '4 GB'
    }

    withName:CNV_MALIGNANCY {
        cpus = 2
        memory = '5 GB'
    }

    withName:TUMOR_STATE_DE {
        cpus = 2
        memory = '5 GB'
    }

    withName:FUNCTIONAL_ENRICHMENT {
        cpus = 1
        memory = '3 GB'
    }
}

report {
    enabled = true
    file = 'results/benchmarks/nextflow_report.html'
    overwrite = true
}

timeline {
    enabled = true
    file = 'results/benchmarks/nextflow_timeline.html'
    overwrite = true
}

trace {
    enabled = true
    file = 'results/benchmarks/nextflow_trace.txt'
    overwrite = true
}

dag {
    enabled = true
    file = 'results/benchmarks/nextflow_dag.html'
    overwrite = true
}
